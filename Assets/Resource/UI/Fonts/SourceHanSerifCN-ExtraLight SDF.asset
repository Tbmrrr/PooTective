    characterSequence: "\u573A\u666F \u53A8\u623F \u5267\u60C5 demo\u7248 \u5927\u5802
      \u5EFA\u597D \u4E4B\u540E \u632A\u5230 \u540D\u79F0 \u5185\u5BB9 \u8C03\u67E5
      \u540E \u5BF9\u8BDD\u6846 \u662F\u5426 \u53EF \u62D6\u5165 \u80CC\u5305 \u4E2D
