    characterSequence: "\u573A\u666F \u53A8\u623F \u5267\u60C5 demo\u7248 \u5927\u5802
      \u5EFA\u597D \u4E4B\u540E \u632A\u5230 \u540D\u79F0 \u5185\u5BB9 \u8C03\u67E5
      \u540E \u5BF9\u8BDD\u6846 \u662F\u5426 \u53EF \u62D6\u5165 \u80CC\u5305 \u4E2D
      \u63CF\u8FF0 \u53EF\u5E26 \u53BB \u8BE2\u95EE \u8BC1\u4EBA \u8D28\u8BE2 \u4EBA
      \u8D28\u8BE2\u5BF9\u8BDD \u8D28\u8BE2\u540E \u8BB0\u5FC6 \u641C\u7D22 \u53EF\u641C\u7D22
      \u4FE1\u606F \u641C\u7D22\u540E \u4EFB\u52A1 \u6307\u5F15 \u63D0\u793A\r\n\r\n\u72D2\u72D2
      \u4F60 \u7EC8\u4E8E \u6765\u4E86 \u6211 \u7B49 \u4F60\u597D \u4E45 \u4FA6\u63A2
      \u5148\u751F \u4E0D\u597D\u610F\u601D \u6BD4\u5965 \u8BA9 \u60A8 \u4E45\u7B49
      \u4E86 \u5728 \u7535\u8BDD \u91CC \u8BF4 \u7684 \u5931\u7A83\u6848 \u662F \u600E\u4E48\u56DE\u4E8B
