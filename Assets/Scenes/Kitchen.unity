    newCharacterDesc: "\u91CE\u732A\u7684file\n\u4FA6\u63A2\u7B14\u8BB0\uFF1A\n\xB7
      \u53A8\u5E08\u957F\u4E00\u5B57\u503C\u5343\u91D1\u3002\n\xB7 \u5E94\u8BE5\u662F\u77E5\u9053\u5185\u60C5\uFF0C\u4F46\u8BDD\u592A\u5C11\u4E86\u6CA1\u6709\u7834\u7EFD\u3002\n\n\u56DE\u7B54\u5F88\u72B9\u8C6B\u7684\u6837\u5B50\u8BA9\u6211\u611F\u5230\u66F4\u5947\u602A\u4E86\u3002\n\n\u4ED6\u8BF4\u201C\u6CA1\u770B\u5230\u201D\uFF0C\u800C\u4E0D\u662F\u201C\u4E0D\u77E5\u9053\u201D\u3002\u4ED6\u5927\u6982\u6E05\u695A\u5C0F\u5077\u662F\u8C01\u3002"
