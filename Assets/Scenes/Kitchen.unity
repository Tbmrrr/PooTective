--- !u!114 &2004902820
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2004902818}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 56d0fbeab9f4ab442b134c98ddb19fb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueFile: {fileID: 4900000, guid: 5b0beb93b1d89dc45ae7f3e01172516f, type: 3}
  npcDisplayName: "\u91CE\u732A\u4E3B\u53A8"
  pressEPrompt: {fileID: 1077179935}
  optionsMenu: {fileID: 1572006788}
  npcNameUI: {fileID: 1617621008}
  evidenceResponses:
  - evidenceID: newspaper
    responseDialogue:
    - "\u4FA6\u63A2\uFF1A\u6700\u8FD1\u5403\u80E1\u841D\u535C\u7684\u5BA2\u4EBA\u662F\u4E0D\u662F\u5F88\u5C11\u3002"
    - "\u91CE\u732A\uFF1A\u2026\u2026\u55EF\u2026\u2026\u662F\u7684\u2026\u2026"
    - "\u4FA6\u63A2\uFF1A\u54E6\u90A3\u5C82\u4E0D\u662F\u5269\u4E86\u5F88\u591A\u80E1\u841D\u535C\u3002"
    - "\u91CE\u732A\uFF1A\u2026\u2026\u662F\u6709\u4E00\u4E9B\u3002"
    - "\u4FA6\u63A2\uFF1A\uFF08\u770B\u6765\u9152\u5E97\u9910\u5385\u7684\u80E1\u841D\u535C\u786E\u5B9E\u6EDE\u9500\u4E86\u3002\uFF09"
    updatedDescription: " \u4E00\u5219\u89E3\u8BFB\u80E1\u841D\u535C\u7814\u7A76\u7684\u65B0\u95FB
      \u6700\u8FD1\u5173\u4E8E\u201C\u80E1\u841D\u535C\u4E0D\u5229\u4E8E\u6BDB\u53D1\u4FDD\u517B\u201D\u7684\u4F20\u8A00\u5E7F\u4E3A\u6D41\u4F20\u3002\u4E8B\u5B9E\u4E0A\uFF0C\u8FD9\u53EA\u662F\u4E00\u5BB6\u4FDD\u5065\u54C1\u516C\u53F8\u4E3A\u4E86\u63A8\u9500\u4ED6\u4EEC\u7684\u6297\u7CD6\u836F\u800C\u8FDB\u884C\u7684\u7092\u4F5C\u3002\u80E1\u841D\u535C\u4E00\u4E0B\u5B50\u4ECE\u5065\u5EB7\u98DF\u6750\u53D8\u4E3A\u6BDB\u53D1\u6740\u624B\u3002\u90A3\u4E9B\u8BB2\u7A76\u6BDB\u53D1\u7684\uFF0C\u6015\u662F\u90FD\u4FE1\u4E86\u3002\u9152\u5E97\u7684\u5BA2\u4EBA\u4E5F\u76F8\u4FE1\u4E86\u8FD9\u4E2A\u9B3C\u8BDD\uFF0C\u9910\u5385\u91CC\u66FE\u7ECF\u6700\u53D7\u52A8\u7269\u559C\u7231\u7684\u80E1\u841D\u535C\u5982\u4ECA\u6EDE\u9500\u4E86\u3002   
      \u4E00\u5219\u8089\u7C7B\u4EF7\u683C\u4E0A\u5347\u7684\u7ECF\u6D4E\u5FEB\u8BAF
      \u4E0D\u65AD\u4E0A\u6DA8\u7684\u8089\u7C7B\u53CA\u52A8\u7269\u526F\u4EA7\u54C1\u4EF7\u683C\uFF0C\u4E00\u76F4\u662F\u7B2C\u4E00\u57CE\u68D8\u624B\u7684\u7ECF\u6D4E\u4E0E\u6C11\u751F\u96BE\u9898\u3002 
      \u4E00\u5C01\u5173\u4E8E\u5171\u540C\u7EF4\u62A4\u57CE\u5E02\u73AF\u5883\u536B\u751F\u7684\u5021\u8BAE\u4E66
      \u968F\u7740\u79FB\u6C11\u589E\u591A\uFF0CD.D.D.\u7684\u7CAA\u4FBF\u5904\u7406\u538B\u529B\u65E5\u76CA\u589E\u957F\u3002\u5728\u7B2C\u4E00\u57CE\uFF0C\u666E\u53CA\u9A6C\u6876\u3001\u63D0\u9AD8\u5E02\u6C11\u968F\u624B\u6E05\u7406\u7CAA\u4FBF\u7684\u610F\u8BC6\uFF0C\u5DF2\u8FEB\u5728\u7709\u776B\u3002"
    characterIDToUpdate: pigchef
    newCharacterDesc: "\u91CE\u732A\u7684file\n\u4FA6\u63A2\u7B14\u8BB0\uFF1A\n\xB7
      \u53A8\u5E08\u957F\u4E00\u5B57\u503C\u5343\u91D1\u3002\n\xB7 \u5E94\u8BE5\u662F\u77E5\u9053\u5185\u60C5\uFF0C\u4F46\u8BDD\u592A\u5C11\u4E86\u6CA1\u6709\u7834\u7EFD\u3002\n\n\u56DE\u7B54\u5F88\u72B9\u8C6B\u7684\u6837\u5B50\u8BA9\u6211\u611F\u5230\u66F4\u5947\u602A\u4E86\u3002"
  - evidenceID: video
    responseDialogue:
    - "\u4FA6\u63A2\uFF1A\u4F60\u7ECF\u5E38\u8FDB\u51B0\u5E93\uFF1F"
    - "\u91CE\u732A\uFF1A\u2026\u2026\u8FD9\u6709\u4EC0\u4E48\u95EE\u9898\uFF1F"
    - "\u4FA6\u63A2\uFF1A\u55EF\u3002\u53A8\u5E08\u957F\u8FDB\u51B0\u5E93\u53D6\u98DF\u6750\uFF0C\u6B63\u5E38\u3002\u90A3\uFF0C\u76D1\u63A7\u91CC\u7684\u90A3\u4E2A\u957F\u9888\u9E7F\u5462\uFF1F"
    - "\u91CE\u732A\uFF1A\u5B81\u5A1C\u3002\u5979\u8D1F\u8D23\u51B0\u5E93\u6E05\u6D01\u3002\u5979\u8FDB\u53BB\u8FC7\u5F88\u6B63\u5E38\u5427\u3002"
    - "\u4FA6\u63A2\uFF1A\u884C\uFF0C\u77E5\u9053\u4E86\u3002"
    updatedDescription: "\u51B0\u5E93\u5185\u90E8\u5E76\u6CA1\u6709\u76D1\u63A7\u3002\u6839\u636E\u51B0\u5E93\u95E8\u53E3\u7684\u76D1\u63A7\u6765\u770B\uFF0C\u8FD9\u51E0\u5929\u53EA\u6709\u65AF\u79D1\u3001\u5B81\u5A1C\u548C\u6BD4\u5965\u8FDB\u5165\u8FC7\u51B0\u5E93\u3002\u53EA\u6709\u65AF\u79D1\u4ECE\u51B0\u5E93\u5E26\u51FA\u8FC7\u98DF\u6750\uFF0C\u800C\u4E14\u5E76\u6CA1\u6709\u4EC0\u4E48\u5F02\u5E38\u3002\u9664\u4E86\u53A8\u5E08\u957F\u65AF\u79D1\u548C\u8001\u677F\u6BD4\u5965\uFF0C\u9152\u5E97\u5E2E\u5DE5\u5B81\u5A1C\u4E5F\u4F1A\u8FDB\u5165\u51B0\u5E93\u505A\u6E05\u6D01\u3002\u5979\u7684\u5ACC\u7591\u975E\u5E38\u5927\u3002"
    characterIDToUpdate: 
    newCharacterDesc: 
  - evidenceID: vegetable
    responseDialogue:
    - "\u4FA6\u63A2\uFF1A\u4F60\u77E5\u9053\u4EC0\u4E48\u4EBA\u5077\u5403\u8FD9\u4E9B\u852C\u83DC\u5417\uFF1F"
    - "\u91CE\u732A\uFF1A\u6211\u6CA1\u770B\u89C1\u3002\u2026\u2026\u518D\u8BF4\uFF0C\u90A3\u4E9B\u852C\u83DC\u90FD\u662F\u4E0D\u65B0\u9C9C\u7684\u3002\u9664\u975E\u997F\u72E0\u4E86\uFF0C\u6CA1\u4EBA\u4F1A\u5077\u5403\u3002"
    - "\u4FA6\u63A2\uFF1A\u597D\u5427\u3002"
    - "\u4FA6\u63A2\uFF1A\uFF08\u4ED6\u8BF4\u201C\u6CA1\u770B\u5230\u201D\uFF0C\u4E0D\u662F\u201C\u4E0D\u77E5\u9053\u201D\u3002\uFF09"
    updatedDescription: 
    characterIDToUpdate: pigchef
    newCharacterDesc: "\u91CE\u732A\u7684file\n\u4FA6\u63A2\u7B14\u8BB0\uFF1A\n\xB7
      \u53A8\u5E08\u957F\u4E00\u5B57\u503C\u5343\u91D1\u3002\n\xB7 \u5E94\u8BE5\u662F\u77E5\u9053\u5185\u60C5\uFF0C\u4F46\u8BDD\u592A\u5C11\u4E86\u6CA1\u6709\u7834\u7EFD\u3002\n\n\u56DE\u7B54\u5F88\u72B9\u8C6B\u7684\u6837\u5B50\u8BA9\u6211\u611F\u5230\u66F4\u5947\u602A\u4E86\u3002\n\n\u4ED6\u8BF4\u201C\u6CA1\u770B\u5230\u201D\uFF0C\u800C\u4E0D\u662F\u201C\u4E0D\u77E5\u9053\u201D\u3002\u4ED6\u5927\u6982\u6E05\u695A\u5C0F\u5077\u662F\u8C01\u3002"
  conditionalEvidenceResponses: []
  defaultWrongResponse:
  - "\u91CE\u732A\u4E3B\u53A8\uFF1A\u6211\u5BF9\u8FD9\u4E2A\u6CA1\u4EC0\u4E48\u4FE1\u606F\u8865\u5145\u3002"
